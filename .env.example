# URL của BE (BE/src/index.ts, mặc định PORT=3001)
NEXT_PUBLIC_API_URL=http://localhost:3001

# Bản demo: true thì không gọi BE, đọc snapshot trong public/demo-data (npm run snapshot:demo)
NEXT_PUBLIC_DEMO_MODE=false

# Chỉ dùng khi chạy npm run snapshot:demo: tài khoản admin để đăng nhập BE (không commit giá trị thật)
# SNAPSHOT_USERNAME=
# SNAPSHOT_PASSWORD=
